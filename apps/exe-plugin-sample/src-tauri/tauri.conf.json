{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCV EXE Plugin Sample",
  "version": "0.1.0",
  "identifier": "com.mcv.exe-plugin-sample",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MCV EXE Plugin Sample",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default capabilities for the main window",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:event:allow-listen",
            "core:event:allow-emit",
            "shell:allow-open"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  },
  "plugins": {}
}
