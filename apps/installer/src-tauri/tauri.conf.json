{
  "productName": "MultiCommentViewer Installer",
  "version": "0.1.0",
  "identifier": "com.mcv.installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MultiCommentViewer Installer",
        "width": 800,
        "height": 600,
        "resizable": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "installer-capability",
          "description": "Installer app capability",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:event:allow-listen",
            "core:event:allow-emit",
            "core:window:allow-close"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
