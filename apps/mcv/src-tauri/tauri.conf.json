{
  "productName": "MultiCommentViewer",
  "version": "0.1.0",
  "identifier": "com.mcv.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
